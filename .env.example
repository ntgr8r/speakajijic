# SpeakAjijic Environment Configuration
# Copy this file to .env and fill in the values.

# OpenAI API key (required for AI-assisted features)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Flask secret key (used to sign session cookies — change this in production)
SECRET_KEY=change-me-to-a-random-secret

# Set to "true" to enable Flask debug mode (development only)
FLASK_DEBUG=false

# Port to run the app on (default: 5000)
PORT=5000
